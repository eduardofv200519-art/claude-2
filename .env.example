# Copia este archivo a .env y pon tu API key de DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-tu-key-aqui

# Opcional: fija un modelo. Si lo dejas comentado, la app detecta automáticamente
# el modelo vigente consultando /models (DeepSeek renombra sus modelos entre versiones).
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PORT=3000
