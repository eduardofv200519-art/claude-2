# Proveedor de IA: deepseek | gemini | groq | openrouter | cerebras | mistral
# Con plan gratuito: gemini, groq, openrouter (modelos :free), cerebras, mistral. DeepSeek es de pago (muy barato).
AI_PROVIDER=gemini
AI_API_KEY=pega-aqui-tu-key

# Opcional: fija un modelo. Si lo dejas comentado, la app detecta el modelo de chat adecuado
# consultando /models del proveedor (los nombres cambian entre versiones).
# AI_MODEL=
# AI_BASE_URL=
# PORT=3000

# Compatibilidad: DEEPSEEK_API_KEY / DEEPSEEK_MODEL / DEEPSEEK_BASE_URL siguen funcionando.
